? Array operations
numbers: [1, 2, 3, 4, 5] ? array literal
first: numbers[0] ? valid no compiler error
first: numbers{0} ? linter error "invalid array access syntax, use array[] instead of dict{}"
first: numbers<0> ? linter error "invalid array access syntax, use array[] instead of object<>"

? dict access
dict_numbers: {1:"one", 2:"two", 3:"three", 4:"four", 5:"five"} ? dict literal
first: dict_numbers["1"] ? linter error "invalid dict access syntax, use dict{} instead of array[]"
first: dict_numbers{"1"} ? valid syntax no compiler error
first: dict_numbers<"1"> ? linter error "invalid dict access syntax, use dict{} instead of object<>"

? object access
first: object_numbers["one"] ? linter error "invalid dict access syntax, use dict{} instead of array[]"
first: object_numbers{"one"} ? linter	error "invalid object access syntax, use object<> instead of array[]"
first: object_numbers<"one"> ? valid syntax no compiler error
first: object_numbers<"one"> ? valid syntax no compiler error

object_numbers: <one:"one", two:"two", three:"three", four:"four", five:"five"> ? fyi this is an object literal not an array literal

object_numbers: <1:"one", 2:"two", 3:"three", 4:"four", 5:"five"> ? should give linter error	 "object keys must be strings"
first: object_numbers.one ? valid syntax should not give compiler error fives use of undecalered variable

